COMPOSE_PROJECT_NAME=internal-tools
TZ=UTC

DOMAIN_ERRORS=issues.bobadilla.tech
DOMAIN_TASKS=tasks.bobadilla.tech
DOMAIN_FLOWS=flows.bobadilla.tech
ACME_EMAIL=eliaz@bobadilla.tech

CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=change-this-with-caddy-hash-password

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
GLITCHTIP_IMAGE=glitchtip/glitchtip:latest
PLANE_IMAGE=makeplane/plane-aio-community:stable
N8N_IMAGE=n8nio/n8n:latest

POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=change-me-superuser

GLITCHTIP_DB_NAME=glitchtip_db
GLITCHTIP_DB_USER=glitchtip_user
GLITCHTIP_DB_PASSWORD=change-me-glitchtip-db-password
GLITCHTIP_SECRET_KEY=change-me-glitchtip-secret-key
GLITCHTIP_STORAGE_ACCESS_KEY=glitchtip-access
GLITCHTIP_STORAGE_SECRET_KEY=change-me-glitchtip-storage-password
GLITCHTIP_BUCKET=glitchtip-files

PLANE_DB_NAME=plane_db
PLANE_DB_USER=plane_user
PLANE_DB_PASSWORD=change-me-plane-db-password
PLANE_SECRET_KEY=change-me-plane-secret-key
PLANE_LIVE_SECRET_KEY=change-me-plane-live-secret-key
PLANE_AWS_ACCESS_KEY_ID=plane-access
PLANE_AWS_SECRET_ACCESS_KEY=change-me-plane-storage-password
PLANE_BUCKET=plane-uploads

RABBITMQ_VHOST=plane
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me-rabbitmq-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

N8N_DB_NAME=n8n_db
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=change-me-n8n-db-password
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
