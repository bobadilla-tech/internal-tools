N8N_HOST=flows.bobadilla.tech
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://flows.bobadilla.tech
WEBHOOK_URL=https://flows.bobadilla.tech
N8N_TRUST_PROXY=true
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-n8n-encryption-key
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=change-me-n8n-db-password
DB_POSTGRESDB_SCHEMA=public
NODE_ENV=production
GENERIC_TIMEZONE=UTC
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
N8N_WORKFLOW_HISTORY_PRUNE_TIME=30
