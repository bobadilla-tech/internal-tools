CORS_ALLOWED_ORIGINS=https://tasks.bobadilla.tech
SECRET_KEY=change-me-plane-secret-key
LIVE_SERVER_SECRET_KEY=change-me-plane-live-secret-key
FILE_SIZE_LIMIT=10485760
