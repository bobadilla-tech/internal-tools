SECRET_KEY=change-me-glitchtip-secret-key
DATABASE_URL=postgresql://glitchtip_user:change-me-glitchtip-db-password@postgres:5432/glitchtip_db
REDIS_URL=redis://redis:6379/1
GLITCHTIP_DOMAIN=https://issues.bobadilla.tech
DEFAULT_FROM_EMAIL=glitchtip@interal.bobadilla.tech
# For real outbound email (Resend SMTP), use the format below.
# EMAIL_URL=smtp://resend:<resend_api_key>@smtp.resend.com:465/?ssl=True
EMAIL_URL=consolemail://
ALLOWED_HOSTS=issues.bobadilla.tech
CSRF_TRUSTED_ORIGINS=https://issues.bobadilla.tech
ENABLE_USER_REGISTRATION=true
ENABLE_ORGANIZATION_CREATION=true
GLITCHTIP_INSTANCE_NAME=Internal Tools GlitchTip
GLITCHTIP_ENABLE_UPTIME=false
GLITCHTIP_ENABLE_LOGS=true
GLITCHTIP_ENABLE_MCP=true
GLITCHTIP_EMBED_WORKER=true
GLITCHTIP_RETENTION_DAYS=30
GLITCHTIP_EVENT_RETENTION_DAYS=30
GLITCHTIP_EVENT_HOT_DAYS=7
GLITCHTIP_TRANSACTION_RETENTION_DAYS=30
GLITCHTIP_LOG_RETENTION_DAYS=30
GLITCHTIP_LOG_HOT_DAYS=3
GLITCHTIP_UPTIME_RETENTION_DAYS=30
GLITCHTIP_FILE_RETENTION_DAYS=30
GLITCHTIP_RELEASE_RETENTION_DAYS=365
LOG_LEVEL=INFO
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_ACCESS_KEY_ID=glitchtip-access
AWS_SECRET_ACCESS_KEY=change-me-glitchtip-storage-password
AWS_STORAGE_BUCKET_NAME=glitchtip-files
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1
GLITCHTIP_COLD_STORAGE_CLEANUP_ENABLED=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
